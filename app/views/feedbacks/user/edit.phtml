<form
    action="<?= route('user.feedbacks.update', ['id' => $paramId]) ?>" method="POST"
    class="flex flex-col gap-6 items-start w-3/4 mx-auto text-black py-4"
>
    <input type="hidden" name="_method" value="PUT">

    <h1 class="text-center w-full rf-2xl mb-0 pb-0 font-ws text-primary/75 font-bold">Modificação de feedback</h1>

    <div class="w-full">
        <h2 class="rf-md mb-2">Tipo *</h2>
        <select name="feedback[type]" class="default-input w-full" id="feedback-type-select">
            <option value="">Selecione</option>

            <option 
                value="complaint" 
                <?= $feedback->type === 'complaint' ? 'selected' : '' ?>
            >
                <?= 
                    ucfirst(
                        string: translate(
                            key: "feedback_types", value:"complaint"
                        )
                    ) 
                ?>
            </option>

            <option 
                value="compliment" 
                <?= $feedback->type === 'compliment' ? 'selected' : '' ?>
            >
                <?= 
                    ucfirst(
                        string: translate(
                            key: "feedback_types", value:"compliment"
                        )
                    ) 
                ?>
            </option>

            <option 
                value="question" 
                <?= $feedback->type === 'question' ? 'selected' : '' ?>
            >
                <?= 
                    ucfirst(
                        string: translate(
                            key: "feedback_types", value:"question"
                        )
                    ) 
                ?>
            </option>

            <option 
                value="suggestion" 
                <?= $feedback->type === 'suggestion' ? 'selected' : '' ?>
            >
                <?= 
                    ucfirst(
                        string: translate(
                            key: "feedback_types", value:"Sugestão"
                        )
                    ) 
                ?>
            </option>
        </select>
