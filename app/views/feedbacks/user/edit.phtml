                ></i>
            </label>
            <input 
                type="radio" 
                name="feedback[rating]" 
                id="rating-one" 
                value="1"
                class="hidden"
                <?= $feedback->rating === 1 ? 'checked' : '' ?>
            >

            <label for="rating-two" class="text-3xl">
                <i 
                    class="<?= $feedback->rating >= 2 ? 'fa-solid' : 'fa-regular' ?> fa-regular fa-star text-yellow-600"
                ></i>
            </label>
            <input 
                type="radio" 
                name="feedback[rating]" 
                id="rating-two" 
                value="2"
                class="hidden"
                <?= $feedback->rating === 2 ? 'checked' : '' ?>
            >

            <label for="rating-three" class="text-3xl">
                <i 
                    class="<?= $feedback->rating >= 3 ? 'fa-solid' : 'fa-regular' ?> fa-regular fa-star text-yellow-600"
                ></i>
            </label>
            <input 
                type="radio" 
                name="feedback[rating]" 
                id="rating-three" 
                value="3"
                class="hidden"
                <?= $feedback->rating === 3 ? 'checked' : '' ?>
            >

            <label for="rating-four" class="text-3xl">
                <i 
                    class="<?= $feedback->rating >= 4 ? 'fa-solid' : 'fa-regular' ?> fa-regular fa-star text-yellow-600">
                </i>
            </label>
            <input 
                type="radio" 
                name="feedback[rating]" 
                id="rating-four" 
                value="4"
                class="hidden"
                <?= $feedback->rating === 4 ? 'checked' : '' ?>
            >

            <label for="rating-five" class="text-3xl">
                <i 
                    class="<?= $feedback->rating >= 5 ? 'fa-solid' : 'fa-regular' ?> fa-regular fa-star text-yellow-600"
                ></i>
            </label>
            <input 
                type="radio" 
                name="feedback[rating]" 
                id="rating-five" 
                value="5"
                class="hidden"
                <?= $feedback->rating === 5 ? 'checked' : '' ?>
